# Copy to .env next to compose.yml. In CI/CD this file is generated from GitHub Environment variables.

# Image to run (CI sets this to ghcr.io/<owner>/<repo>:<sha>)
IMAGE=multithreaded-redis:local

# Server config
REDIS_POOL_SIZE=100000
REDIS_MAX_WAITING_CONNS=10000
REDIS_BUFFER_SIZE=2048
REDIS_LOG_LEVEL=info

# Where the monitoring stack lives.
#   Same host:      http://host.docker.internal:3100 / :9009
#   Separate host:  http://monitoring.internal:3100   / :9009
LOKI_URL=http://host.docker.internal:3100
MIMIR_URL=http://host.docker.internal:9009

# Labels attached to every log line and metric from this host
HOST_NAME=local
ENVIRONMENT=dev
