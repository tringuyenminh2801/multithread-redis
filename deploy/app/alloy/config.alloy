// Grafana Alloy: collects container logs -> Loki, and scrapes metrics -> Mimir.
// Endpoints come from env vars so the same config works whether the monitoring
// stack runs on this host or a separate one.

// ---------------------------------------------------------------- logs

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  // "/redis-app-redis-1" -> container="redis-app-redis-1"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // compose service name, e.g. service="redis"
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.app.receiver]
}

// Promote the slog "level" field to a label so Grafana can filter/colour by it.
// Keep labels low-cardinality: never promote addresses, keys or worker ids.
loki.process "app" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }

  external_labels = {
    host        = sys.env("HOST_NAME"),
    environment = sys.env("ENVIRONMENT"),
  }
}

// ---------------------------------------------------------------- metrics

prometheus.scrape "redis" {
  targets         = [{ "__address__" = "redis:2112" }]
  job_name        = "redis"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "cadvisor" {
  targets         = [{ "__address__" = "cadvisor:8080" }]
  job_name        = "cadvisor"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "node" {
  targets         = [{ "__address__" = "node-exporter:9100" }]
  job_name        = "node"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = sys.env("MIMIR_URL") + "/api/v1/push"
  }

  external_labels = {
    host        = sys.env("HOST_NAME"),
    environment = sys.env("ENVIRONMENT"),
  }
}
